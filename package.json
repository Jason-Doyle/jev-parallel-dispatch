{
  "name": "jev-parallel-dispatch",
  "version": "0.1.0",
  "description": "A live browser simulation demonstrating Jev parallel decisions and deterministic optimisation.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsup server/index.ts --format esm --platform node --target node22 --out-dir dist-server --clean --sourcemap",
    "start": "node dist-server/index.js",
    "benchmark:fanout": "tsx scripts/benchmark-fanout.ts",
    "capture:demo": "npm run build && tsx scripts/capture-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write .",
    "validate": "npm run check && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "browser-game",
    "game-ai",
    "jev",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jason-Doyle/jev-parallel-dispatch.git"
  },
  "bugs": {
    "url": "https://github.com/Jason-Doyle/jev-parallel-dispatch/issues"
  },
  "homepage": "https://github.com/Jason-Doyle/jev-parallel-dispatch#readme",
  "license": "MIT",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
